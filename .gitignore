.DS_Store
Thumbs.db
*.log

# Raw Midjourney exports for the landing page - kept locally as source material, but
# the compressed images/landing-bg/landing-NN.jpg copies (see js/landing-backgrounds.js)
# are what actually ships. These originals average ~1.9MB each and aren't worth the repo
# weight once a JPEG copy exists.
images/landing-bg/*.png

# Same reasoning as above, for the app-wide (not landing-page) background pool - see
# js/app-backgrounds.js and images/README.txt.
images/app-bg/*.png

# Zipped copy generated for direct delivery of docs/blank-app-template/ - the actual
# source files are already tracked individually, this is just a packaging convenience.
docs/blank-app-template.zip
